; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Светлячок: Совиная ночь"
config/description="Гиперказуальная головоломка: нарисуй путь светлячка домой. Время в лесу идёт, только пока растёт линия."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.02, 0.08, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Progress="*res://scripts/progress.gd"
Sfx="*res://scenes/audio.tscn"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/theme.tres"
theme/custom_font="res://ui/NotoSans-Bold.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.08, 1)
